# SparrowPay Backend Environment Variables
# Copy this file to .env and fill in the values for your local setup.

# ----- Runtime -----
NODE_ENV=development
PORT=5000

# ----- Database -----
# Get this string from MongoDB Atlas (Connect -> Drivers -> Node.js).
# IMPORTANT: replace USERNAME, PASSWORD, and the cluster host.
# The database name is appended after .net/ -> /sparrowpay
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/sparrowpay?retryWrites=true&w=majority

# ----- Auth / JWT -----
# Use long random strings (>= 32 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_very_long_random_secret_at_least_32_chars
JWT_REFRESH_SECRET=replace_with_another_very_long_random_secret_for_refresh_tokens
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# ----- CORS -----
# Comma-separated list of allowed frontend origins.
# Local dev:    http://localhost:5173
# Production:   https://your-app.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ----- Encryption (AES-256-GCM) -----
# Optional but recommended. Used to encrypt phone & CNIC at rest.
# Generate a 32-byte base64 key with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# If left blank, sensitive fields are stored in plaintext (development only).
MASTER_ENC_KEY=

# ----- Business -----
# Initial wallet balance in PKR for new accounts.
INITIAL_BALANCE=20000

# ----- Rate Limiting -----
# Window in ms and maximum requests per window per IP.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
