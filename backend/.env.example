# SparrowPay Backend Environment Variables
# Copy this file to .env and fill in the values for your local setup.

# ----- Runtime -----
NODE_ENV=development
PORT=5000

# ----- Database -----
# Get this string from MongoDB Atlas (Connect -> Drivers -> Node.js).
# IMPORTANT: replace USERNAME, PASSWORD, and the cluster host.
# The database name is appended after .net/ -> /sparrowpay
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/sparrowpay?retryWrites=true&w=majority

# ----- Auth / JWT -----
# Use long random strings (>= 32 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=16e3ae24166172daff357350f6191831e5fb5c59825b894605c294ea29f4ad2740092e546f496a6f0fce18b0b2d7eb3d
JWT_REFRESH_SECRET=e00d4d1b7df970115ee7d6a5892854ca741a99b13f8628e9cc62d691a1eb2ba27b5df8cc4b4933d0287cb7c8e934654a
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# ----- CORS -----
# Comma-separated list of allowed frontend origins.
# Local dev:    http://localhost:5173
# Production:   https://your-app.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ----- Encryption (AES-256-GCM) -----
# Optional but recommended. Used to encrypt phone & CNIC at rest.
# Generate a 32-byte base64 key with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# If left blank, sensitive fields are stored in plaintext (development only).
MASTER_ENC_KEY=

# ----- Donation blind-signature key -----
# RSA-2048 private key in PKCS#8 PEM format used to sign donation tokens.
# If left blank, the server generates a fresh keypair on first boot and
# persists it to backend/.bank_rsa.pem (gitignored). Set this env var
# explicitly in production so the key survives container rebuilds.
# Generate with:
#   node -e "console.log(require('crypto').generateKeyPairSync('rsa', { modulusLength: 2048, publicExponent: 0x10001 }).privateKey.export({ type: 'pkcs8', format: 'pem' }))"
BANK_RSA_PRIVATE_PEM=

# ----- Business -----
# Initial wallet balance in PKR for new accounts.
INITIAL_BALANCE=20000

# ----- Rate Limiting -----
# Window in ms and maximum requests per window per IP.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
