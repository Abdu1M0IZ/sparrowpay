# SparrowPay Frontend Environment Variables
# Copy to .env (Vite reads .env at the project root automatically).

# Base URL for the backend API. Must end without a trailing slash.
# Local backend on default port:
VITE_API_BASE_URL=http://localhost:5000/api

# When deploying to Vercel, set this in the Vercel project settings to:
#   https://your-render-app.onrender.com/api
